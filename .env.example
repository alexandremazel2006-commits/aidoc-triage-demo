# --- Aidoc demo (worklist triage) ---
# Anthropic (Claude) API key — required for the triage analysis.
# Never commit the real value. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- RadioCheck AI (chest X-ray analysis) ---
# URL of the local FastAPI backend (see backend/). No API key needed — the
# analysis runs entirely locally. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_RADIOCHECK_API_URL=http://localhost:8000
